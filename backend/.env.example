# ─── Servidor ────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Base de datos ───────────────────────────────────────────
# URI de MongoDB Atlas (o local). Incluí el nombre de la base al final.
MONGODB_URI=

# ─── Better Auth ─────────────────────────────────────────────
# Generar con: openssl rand -base64 32
BETTER_AUTH_SECRET=
# URL pública desde la que el navegador habla con /api/auth.
# Local: http://localhost:5173 (Vite proxea /api al backend)
# Producción: la URL del Static Site del frontend en Render
BETTER_AUTH_URL=

# URL del frontend (para CORS y trustedOrigins)
FRONTEND_URL=

# ─── OAuth GitHub ────────────────────────────────────────────
# Callback: <BETTER_AUTH_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ─── OAuth Google (opcional) ─────────────────────────────────
# Callback: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Seed (solo para npm run seed) ───────────────────────────
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_USER_EMAIL=
SEED_USER_PASSWORD=
